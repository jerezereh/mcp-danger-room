{
  "name": "mcp-danger-room",
  "private": true,
  "version": "0.1.0",
  "description": "A digital client for Marvel: Crisis Protocol — roster building, local playtesting, and online play.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @danger-room/web",
    "dev:server": "npm run dev --workspace @danger-room/server",
    "play:demo": "npm run play:demo --workspace @danger-room/web --",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build && tsc -p packages/data/tsconfig.scripts.json && tsc -p apps/web/tsconfig.scripts.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
